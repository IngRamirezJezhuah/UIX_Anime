;;====================================
;; Importaciones de las vistas
;;====================================

(include "./modules/navbar.yuck")
;;(include "./modules/player/player_audio.yuck")
;; aqui añado mas includes conforme avanzo:

(defwindow main_window
    :monitor 0
    :geometry (geometry :x "0%"
                        :y "0%"
                        :width "70%"
                        :height "70%"
                        :anchor "center")
    :stacking "bottom"
    :windowtype "desktop"
    :wm-ignore true 

    (main_box))

  (defwidget main_box []
      (box :class "main-container" :orientation "h" :space-evenly false
        (navbar_widget)
        (box :class "content-area" :orientation "v" :space-evenly false
        ;; las overlay son para sobreponer cosas, hay que dejarla asi dj del futuro
          (overlay
            (image :path "./assets/heh.png"
                   :image-width 900 
                   :image-height 900
                   :preserve-aspect-ratio true)
            (label :text "prueba funciona" :haling "center"))
          ;;(player_widget) ;; llamada al modulo que defino abajo
       )
    ))



